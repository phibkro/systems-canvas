---
import practitionerSvg from './assets/practitioner-vertical.svg?raw';
const lenses=[
 {id:'overview',name:'Overview',title:'One system, connected relationships',focus:'all',note:'Resources enable operations; operations produce outcomes. Rules guide decisions, and observations can change future behavior.'},
 {id:'structure',name:'Structure',title:'Where are capacity and dependencies?',focus:'structure',note:'Stocks and links support activity; resources may be depleted, regenerated, or shared across boundaries.'},
 {id:'behavior',name:'Behavior',title:'What repeats, accumulates, and changes?',focus:'behavior',note:'Flows have rates and delays. A reinforcing or balancing loop is a causal hypothesis until supported by observations.'},
 {id:'knowledge',name:'Knowledge',title:'Who observes and knows what?',focus:'knowledge',note:'Signals are not truth. Show sources, measurement limits, uncertainty, and the route by which evidence reaches decision-makers.'},
 {id:'authority',name:'Authority',title:'Who is allowed to change the rules?',focus:'authority',note:'Governance establishes constraints and rights. Follow the escalation path to those who can revise governance itself.'},
 {id:'purpose',name:'Purpose',title:'Whose goal directs this system?',focus:'purpose',note:'Separate stated purposes, operating targets, and observed function. A goal is not evidence that its intended outcome occurs.'},
 {id:'evaluation',name:'Evaluation',title:'Is the system viable, and for whom?',focus:'evaluation',note:'Measure effects and externalities against explicit criteria. Do not equate organizational survival with human or ecological desirability.'}
];
const leverage=[
 {id:'stocks',label:'Stocks & buffers',zone:'capacity',detail:'Adjust capacity and material reserves; verify what accumulates, depletes, or replenishes.'},
 {id:'flows',label:'Flows & delays',zone:'operation',detail:'Change transfer rates, bottlenecks, latency, and response timing.'},
 {id:'feedback',label:'Feedback strength',zone:'feedback',detail:'Alter reinforcing or balancing loops and the information they require.'},
 {id:'information',label:'Information access',zone:'feedback',detail:'Change who can see evidence, errors, and consequences.'},
 {id:'rules',label:'Rules & authority',zone:'governance',detail:'Reassign permissions, obligations, enforcement, and appeals.'},
 {id:'goals',label:'Goals & paradigms',zone:'governance',detail:'Reconsider what success means and the assumptions governing it.'}
];
---
<div class="system-map" data-system-map aria-label="System Canvas spatial model">
  <header class="map-top">
    <div><strong>System Canvas / Spatial model</strong><small>Illustrative system · Not a causal proof</small></div>
    <label class="leverage-toggle"><input data-leverage-toggle type="checkbox"/> Show intervention levers</label>
  </header>
  <div class="view-tabs" role="group" aria-label="Analytical view">
    {lenses.map((v,i)=><button type="button" data-view={v.id} aria-pressed={i===0?'true':'false'}>{v.name}</button>)}
  </div>
  <div class="diagram-container" set:html={practitionerSvg} />
  <div class="map-insight"><strong data-lens-title>{lenses[0].title}</strong><p data-lens-note>{lenses[0].note}</p></div>
  <div class="leverage-panel" data-leverage-panel hidden>
    <div class="leverage-head"><strong>Possible leverage points</strong><span>Meadows-inspired taxonomy · not ranked or validated</span></div>
    <div class="leverage-buttons" role="group" aria-label="Intervention types">
      {leverage.map((v)=><button data-leverage={v.id} data-zone-target={v.zone} aria-pressed="false" type="button">{v.label}</button>)}
    </div>
    <p class="leverage-description" data-leverage-description>Select an intervention type to highlight where it acts. An intervention may cross multiple regions.</p>
  </div>
  <p class="diagram-caveat">Arrows denote a useful interpretation of dependencies and regulation. They do not assert that every resource is a stock, that every relationship is causal, or that every organization follows one universal configuration.</p>
</div>
<script define:vars={{lenses,leverage}}>
  document.querySelectorAll('[data-system-map]').forEach(root=>{
    const setLens=id=>{
      const v=lenses.find(v=>v.id===id)||lenses[0];root.dataset.focus=v.focus;
      root.querySelectorAll('[data-view]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.view===id)));
      root.querySelector('[data-lens-title]').textContent=v.title;
      root.querySelector('[data-lens-note]').textContent=v.note;
    };
    root.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>setLens(b.dataset.view)));
    root.querySelector('[data-leverage-toggle]').addEventListener('change',e=>{
      root.querySelector('[data-leverage-panel]').hidden=!e.target.checked;
      if(!e.target.checked)root.dataset.leverage='';
    });
    root.querySelectorAll('[data-leverage]').forEach(b=>b.addEventListener('click',()=>{
      const v=leverage.find(v=>v.id===b.dataset.leverage);
      root.dataset.leverage=v.zone;
      root.querySelectorAll('[data-leverage]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));
      root.querySelector('[data-leverage-description]').textContent=v.detail;
    }));
    setLens('overview');
  });
</script>
<style is:global>
.system-map{border:1px solid var(--color-border,#536960);background:var(--color-surface,#152521);color:var(--color-text,#e9f2ee);border-radius:14px;padding:clamp(12px,2.3vw,24px);margin:24px 0}.system-map *{box-sizing:border-box}.map-top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.map-top strong{font-size:15px;display:block}.map-top small{font-size:11px;opacity:.75;display:block;margin-top:4px}.leverage-toggle{display:flex;gap:7px;align-items:center;font-size:12px;cursor:pointer}.leverage-toggle input{accent-color:#64b89f}.view-tabs{display:flex;flex-wrap:wrap;gap:5px;margin:17px 0}.view-tabs button,.leverage-buttons button{color:inherit;background:transparent;border:1px solid #69827a;border-radius:6px;padding:8px 10px;font-size:12px;cursor:pointer}.view-tabs button[aria-pressed=true],.leverage-buttons button[aria-pressed=true]{background:#286453;color:white;border-color:#8ee6c4;box-shadow:inset 0 0 0 1px #8ee6c4}.system-map button:focus-visible{outline:2px solid #87ddbd;outline-offset:2px}.diagram-container{overflow-x:auto}.canvas-svg{display:block;min-width:680px;width:100%;height:auto;overflow:visible}.canvas-svg text{paint-order:normal}.zone{transition:opacity .15s}.zone-fill{stroke:#709188;stroke-width:1.5;fill:#6b948a;fill-opacity:.10}.zone-fill.operation{fill:#4fbda1;fill-opacity:.16;stroke:#64b89f}.zone-fill.gov{fill:#849bc6;fill-opacity:.13;stroke:#8197bb}.zone-fill.eval{fill:#c09b65;fill-opacity:.11;stroke:#b29a77}.eyebrow{fill:currentColor;font-size:10px;opacity:.74;letter-spacing:1px;font-weight:700}.zone-title{fill:currentColor;font-size:19px;font-weight:700;letter-spacing:-.3px}.zone-subtitle{fill:currentColor;font-size:12px;opacity:.85}.boundary-text{fill:currentColor;font-size:10px;opacity:.6;letter-spacing:1px}.edge{transition:opacity .15s}.edge path{fill:none;stroke-width:3}.edge .primary{stroke:#64b89f}.edge .secondary{stroke:#9aabc5;stroke-dasharray:5 5}.edge-text{fill:currentColor;font-size:12px;opacity:.75}.feedback-path{stroke-width:2}.feedback-label{fill:#253b3b;stroke:#69827a}.feedback-text{fill:#e6f5ee;font-size:13px;font-weight:650}.revision-path{opacity:0}.map-insight{padding:14px 16px;border:1px solid #69827a;border-radius:9px;margin-top:7px}.map-insight strong{font-size:14px}.map-insight p{font-size:13px;line-height:1.6;margin:5px 0}.leverage-panel{margin-top:14px;padding:13px;border:1px solid #69827a;border-radius:9px}.leverage-panel[hidden]{display:none}.leverage-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px}.leverage-head strong{font-size:13px}.leverage-head span{opacity:.7;font-size:11px}.leverage-buttons{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0}.leverage-description{font-size:12px;margin:0;line-height:1.5}.diagram-caveat{font-size:11px;opacity:.7;line-height:1.5;margin:12px 0 0}

.system-map[data-focus=structure] .zone:not([data-zone=capacity]):not([data-zone=operation]),
.system-map[data-focus=behavior] .zone:not([data-zone=operation]),
.system-map[data-focus=knowledge] .zone:not([data-zone=feedback]),
.system-map[data-focus=authority] .zone:not([data-zone=governance]),
.system-map[data-focus=purpose] .zone:not([data-zone=governance]),
.system-map[data-focus=evaluation] .zone:not([data-zone=evaluation]):not([data-zone=outcomes]) {opacity:.25}
.system-map[data-focus=structure] [data-edge]:not([data-edge=material]),
.system-map[data-focus=behavior] [data-edge]:not([data-edge=material]):not([data-edge=feedback]),
.system-map[data-focus=knowledge] [data-edge]:not([data-edge=feedback]),
.system-map[data-focus=authority] [data-edge]:not([data-edge=governance]):not([data-edge=evaluation]),
.system-map[data-focus=purpose] [data-edge]:not([data-edge=governance]):not([data-edge=evaluation]),
.system-map[data-focus=evaluation] [data-edge]:not([data-edge=evaluation]) {opacity:.18}
.system-map[data-leverage=capacity] .zone:not([data-zone=capacity]),
.system-map[data-leverage=operation] .zone:not([data-zone=operation]),
.system-map[data-leverage=governance] .zone:not([data-zone=governance]) {opacity:.22}
.system-map[data-leverage=feedback] [data-edge]:not([data-edge=feedback]) {opacity:.2}
.system-map .canvas-svg{min-width:650px;width:100%;height:auto}
@media(max-width:650px){.map-top{align-items:flex-start}.view-tabs button{font-size:11px}}
</style>
