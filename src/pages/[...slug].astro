---
import DocsLayout from '../layouts/DocsLayout.astro';

export function getStaticPaths() {
  // Astro executes getStaticPaths in an isolated build scope.
  // Keep the import glob inside the function rather than referencing
  // a module-level variable.
  const pages = {
    ...import.meta.glob('../../docs/*.md', { eager: true }),
    ...import.meta.glob('../../research/*.md', { eager: true })
  };
  return Object.entries(pages).map(([path, doc]) => {
    const section = path.includes('/research/') ? 'research' : 'docs';
    const name = path.split('/').pop().replace(/\.md$/, '');
    return { params: { slug: section + '/' + name }, props: { doc, name } };
  });
}
const { doc, name } = Astro.props;
const Content = doc.Content;
const title = doc.frontmatter?.title || name.replace(/^system-canvas-/,'').replace(/-/g,' ');
---
<DocsLayout title={title}><Content /></DocsLayout>
