---
const { title = 'System Canvas', description = 'Open research and practice in systems diagnosis and redesign' } = Astro.props;
const groups = [
  { title: 'Start', links: [['Overview','/'],['Interactive case','/cases/journalism/']] },
  { title: 'Practice', links: [['Course','/docs/system-canvas-course/'],['Field guide','/docs/system-canvas-field-guide/'],['Analytical cases','/docs/system-canvas-analytical-cases/'],['Core thesis','/docs/system-canvas-core/']] },
  { title: 'Research', links: [['Research thesis','/research/system-canvas-research-thesis/'],['Validation protocol','/research/system-canvas-validation-protocol/'],['Expert collaboration','/research/system-canvas-expert-brief/'],['Insight register','/research/system-canvas-insight-register/']] }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#111b20" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · System Canvas</title>
  </head>
  <body>
    <header class="topbar"><a href="/" class="brand"><span class="mark">◈</span> System Canvas</a><nav aria-label="Top navigation"><a href="/cases/journalism/">Explore</a><a href="/docs/system-canvas-course/">Course</a><a href="/research/system-canvas-research-thesis/">Research</a><a href="https://github.com/phibkro/systems-canvas" target="_blank" rel="noopener">GitHub ↗</a></nav></header>
    <div class="shell">
      <aside class="sidebar" aria-label="Documentation">
        {groups.map(group => <section><div class="nav-heading">{group.title}</div>{group.links.map(([name,url]) => <a href={url} aria-current={Astro.url.pathname.replace(/\/$/,'')===url.replace(/\/$/,'')?'page':undefined}>{name}</a>)}</section>)}
      </aside>
      <main id="main" class="main">
        <div class="reading"><slot /></div>
        <footer>Working research framework. Proposed mechanisms are not established empirical findings. · <a href="https://github.com/phibkro/systems-canvas">Source and contributions</a></footer>
      </main>
    </div>
    <script>
      import mermaid from 'mermaid';
      mermaid.initialize({ startOnLoad:false, securityLevel:'strict', theme:'neutral' });
      async function mountDiagrams() {
        for (const pre of document.querySelectorAll('pre')) {
          const code = pre.querySelector('code.language-mermaid');
          if (!code) continue;
          const wrap = document.createElement('div');
          wrap.className = 'mermaid';
          wrap.textContent = code.textContent || '';
          pre.replaceWith(wrap);
        }
        try { await mermaid.run({ querySelector: '.mermaid' }); }
        catch (err) { console.warn('Diagram rendering failed',err); }
      }
      mountDiagrams();
    </script>
  </body>
</html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color-scheme:dark;--bg:#111b20;--panel:#17252b;--panel2:#203039;--line:#30454d;--ink:#e9f1f0;--muted:#9cb0b2;--accent:#8be0c0;background:var(--bg);color:var(--ink);font-synthesis:none}
*{box-sizing:border-box}body{margin:0}a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}.topbar{height:66px;position:sticky;top:0;z-index:5;background:#111b20ed;backdrop-filter:blur(18px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 max(24px,calc((100vw - 1540px)/2));gap:20px}.brand{font-weight:750;font-size:17px;color:var(--ink);letter-spacing:-.03em;white-space:nowrap}.mark{color:var(--accent);font-size:25px;margin-right:5px}.topbar nav{display:flex;gap:22px;font-size:13px;align-items:center}.topbar nav a{color:var(--muted)}.shell{display:grid;grid-template-columns:236px minmax(0,1fr);max-width:1540px;margin:auto;min-height:calc(100vh - 66px)}.sidebar{border-right:1px solid var(--line);padding:26px 18px;align-self:stretch}.sidebar section{margin-bottom:22px;display:grid;gap:3px}.nav-heading{font-size:11px;color:var(--muted);letter-spacing:.12em;text-transform:uppercase;font-weight:700;margin:0 10px 10px}.sidebar a{display:block;padding:9px 10px;color:var(--muted);border-radius:7px;font-size:13px}.sidebar a:hover,.sidebar a[aria-current=page]{color:var(--ink);background:var(--panel2);text-decoration:none}.main{min-width:0;padding:32px clamp(20px,5vw,70px)}.reading{max-width:960px;margin:0 auto}.reading h1{font-size:clamp(2rem,3.6vw,3.4rem);letter-spacing:-.055em;line-height:1.12;margin:24px 0}.reading h2{font-size:1.5rem;margin-top:44px;padding-top:14px;border-top:1px solid var(--line)}.reading h3{font-size:1.16rem;margin-top:30px}.reading p,.reading li{line-height:1.78;color:#ccd9d9}.reading strong{color:#f1f7f6}.reading blockquote{border-left:3px solid var(--accent);margin:22px 0;padding:2px 20px;background:#20343a55}.reading pre{overflow-x:auto;padding:20px;border:1px solid var(--line);border-radius:10px}.reading code:not(pre code){background:var(--panel2);padding:3px 6px;border-radius:5px}.reading table{border-collapse:collapse;display:block;overflow-x:auto;width:100%;font-size:13px}.reading th,.reading td{border-bottom:1px solid var(--line);padding:13px;text-align:left;vertical-align:top;min-width:100px}.reading th{color:var(--ink);background:var(--panel)}.reading td{color:var(--muted)}.reading .mermaid{padding:24px;background:#eff8f5;border-radius:12px;overflow-x:auto;text-align:center}.reading .mermaid svg{max-width:100%;height:auto}footer{max-width:960px;margin:70px auto 0;padding-top:25px;border-top:1px solid var(--line);color:var(--muted);font-size:12px}.eyebrow{color:var(--accent)!important;text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:750}.lead{font-size:1.2rem;max-width:720px}.tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:30px 0}.tile{display:block;border:1px solid var(--line);border-radius:12px;padding:22px;background:var(--panel)}.tile:hover{border-color:var(--accent);text-decoration:none}.tile h3{margin:0 0 8px}.tile p{margin:0;font-size:13px}.muted{color:var(--muted)}@media(max-width:850px){.shell{display:block}.sidebar{display:none}.topbar{padding:0 18px}.topbar nav{gap:12px}.topbar nav a{font-size:12px}.main{padding:20px}.tiles{grid-template-columns:1fr}}@media(max-width:420px){.topbar nav a:nth-child(3){display:none}}
</style>
