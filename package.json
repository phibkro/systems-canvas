{
  "name": "systems-canvas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Stratus-based documentation for the System Canvas framework",
  "scripts": {
    "build": "bash scripts/build-stratus.sh",
    "dev": "bash scripts/build-stratus.sh && cd .stratus-build && npm run dev",
    "preview": "cd .stratus-build && npm run preview",
    "test": "npm run typecheck && vitest run",
    "test:property": "vitest run tests/state.property.test.mjs",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "fast-check": "^4.3.0",
    "@stryker-mutator/core": "^9.3.0",
    "@stryker-mutator/vitest-runner": "^9.3.0",
    "typescript": "^5.9.3",
    "esbuild": "^0.25.12"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  }
}
